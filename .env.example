# Copy to .env.local and fill in. Never commit .env.local. Only NEXT_PUBLIC_* values reach the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile (dev falls back to Cloudflare's published test keys)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=

# Resend transactional email (send from a verified business domain, not Gmail)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
OWNER_EMAIL=mbintltraders@gmail.com

# Random 32+ character strings
RATE_LIMIT_SALT=
CRON_SECRET=

# Consent-gated analytics (optional)
NEXT_PUBLIC_GA4_ID=

# Enable indexing only after business/content verification and launch checks
NEXT_PUBLIC_LAUNCH_READY=false
# Maximum provider send attempts per 24-hour application window
EMAIL_DAILY_LIMIT=90
# Enable only after approving the documented retention policy
RETENTION_ENABLED=false
